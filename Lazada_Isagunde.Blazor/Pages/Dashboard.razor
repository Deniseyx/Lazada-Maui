@page "/dashboard"
@using Lazada_Isagunde.Blazor.Services
@using Lazada_Isagunde.Blazor.Models
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject FirebaseService FirebaseService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Lazada - Just For You</PageTitle>

<div class="dashboard-container">
    <div class="category-strip">
        @foreach (var cat in categories)
        {
            <div class="category-item @(string.Equals(selectedCategory, cat, StringComparison.OrdinalIgnoreCase) ? "active" : "")" 
                 @onclick="() => selectedCategory = cat"
                 role="button"
                 tabindex="0"
                 @onkeydown="@(e => HandleCategoryKeyDown(e, cat))">
                <div class="category-icon">
                    @GetCategoryIcon(cat)
                </div>
                <div class="category-label">@GetCategoryDisplayName(cat)</div>
            </div>
        }
    </div>

    <div class="section-header mb-4">
        <h2 class="section-title">@GetCategoryDisplayName(selectedCategory)</h2>
    </div>

    @if (products == null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading products...</span>
            </div>
        </div>
    }
    else if (!FilteredProducts.Any())
    {
        <div class="alert alert-info">
            @(string.IsNullOrWhiteSpace(searchQuery) ? "No approved products found yet." : $"No products found matching \"{searchQuery}\".")
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in FilteredProducts)
            {
                <div class="product-card" 
                     @onclick="() => NavigateToDetail(product.Id)"
                     role="button"
                     tabindex="0"
                     @onkeydown='@(e => HandleProductKeyDown(e, product.Id))'>
                    <div class="product-image-wrapper">
                        <img src="@product.DisplayImageUrl" 
                             class="product-image" 
                             alt="@product.Title" 
                             onerror="this.src='https://placehold.co/600x400?text=No+Image'" />
                    </div>
                    <div class="product-info">
                        <h5 class="product-title">@product.Title</h5>
                        <p class="product-price">@product.PriceFormatted</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private string GetCategoryDisplayName(string category) => category switch
    {
        "Male Clothes" => "Male",
        "Female Clothes" => "Female",
        _ => category
    };

    private List<Product>? products;
    private string searchQuery = "";
    private string selectedCategory = "General";

    private static readonly string[] categories = { "General", "Electronics", "Jewelry", "Home", "Health", "Male Clothes", "Female Clothes", "Kids" };

    private IEnumerable<Product> FilteredProducts => 
        (products ?? new())
        .Where(p => (string.IsNullOrWhiteSpace(searchQuery) || (p.Title != null && p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                    && (string.Equals(selectedCategory, "General", StringComparison.OrdinalIgnoreCase) 
                        || string.Equals(p.Category, selectedCategory, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Navigation.LocationChanged += HandleLocationChanged;
        UpdateSearchQuery();
        await LoadProducts();
        try
        {
            var allProducts = await FirebaseService.GetProductsAsync();
            foreach (var p in allProducts)
            {
                if (string.Equals(p.Category, "Fashion", StringComparison.OrdinalIgnoreCase))
                {
                    p.Category = "Jewelry";
                    await FirebaseService.UpdateProductAsync(p);
                }
            }
        }
        catch {}
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateSearchQuery();
        StateHasChanged();
    }

    private void HandleCategoryKeyDown(KeyboardEventArgs e, string cat)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            selectedCategory = cat;
        }
    }

    private void HandleProductKeyDown(KeyboardEventArgs e, string? productId)
    {
        if ((e.Key == "Enter" || e.Key == " ") && !string.IsNullOrEmpty(productId))
        {
            NavigateToDetail(productId);
        }
    }

    private RenderFragment GetCategoryIcon(string cat) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddContent(1, cat switch
        {
            "General" => "🛒",
            "Electronics" => "💻",
            "Jewelry" => "✨",
            "Home" => "🏠",
            "Health" => "💊",
            "Male Clothes" => "👕",
            "Female Clothes" => "👗",
            "Kids" => "🧸",
            _ => "📦"
        });
        builder.CloseElement();
    };

    private void UpdateSearchQuery()
    {
        try 
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var q))
            {
                searchQuery = q!;
            }
            else
            {
                searchQuery = "";
            }
        }
        catch 
        {
            searchQuery = "";
        }
    }

    private async Task LoadProducts()
    {
        try 
        {
            // STRICT LOGIC: Only show Approved products on the Dashboard
            products = await FirebaseService.GetProductsAsync("Approved");
        }
        catch (Exception)
        {
            products = new List<Product>();
        }
    }

    private void NavigateToDetail(string? id)
    {
        if (!string.IsNullOrEmpty(id))
        {
            Navigation.NavigateTo($"/product/{id}");
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}

<style>
    .dashboard-container {
        padding: 10px 0;
    }
    .section-title {
        font-size: 24px;
        font-weight: bold;
        color: #000;
        margin-bottom: 20px;
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(188px, 1fr));
        gap: 12px;
    }
    .product-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        height: 310px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
    .product-card:hover {
        box-shadow: var(--card-shadow);
        transform: translateY(-4px);
        border-color: #e0e0e0;
    }
    .product-image-wrapper {
        height: 200px;
        overflow: hidden;
        background-color: #ffffff;
    }
    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .product-info {
        padding: 8px 10px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    .product-title {
        font-size: 14px;
        line-height: 18px;
        color: #212121;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 36px;
        font-weight: normal;
    }
    .product-price {
        color: var(--lazada-orange);
        font-size: 18px;
        font-weight: 500;
        margin-top: auto;
    }
</style>
