@page "/"
@using Lazada_Isagunde.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Welcome to Lazada</PageTitle>

<div class="landing-hero d-flex align-items-center justify-content-center">
    <div class="landing-card text-center p-5 shadow-lg rounded">
        <div class="mb-4">
            <h1 class="display-4 fw-bold text-white">Lazada</h1>
            <p class="lead text-white-50">Your One-Stop Shopping Destination</p>
        </div>
        
        <div class="d-grid gap-3">
            <button class="btn btn-primary btn-lg py-3 rounded-pill" @onclick='() => Navigation.NavigateTo("/login")'>
                Login
            </button>
            <button class="btn btn-outline-light btn-lg py-3 rounded-pill" @onclick='() => Navigation.NavigateTo("/register")'>
                Register
            </button>
        </div>
    </div>
</div>

<style>
    .landing-hero {
        min-height: calc(100vh - 120px);
        background: linear-gradient(135deg, var(--lazada-orange) 0%, #ff9a44 100%);
        margin: -20px -15px;
    }
    .landing-card {
        max-width: 450px;
        width: 100%;
        background-color: rgba(0, 0, 0, 0.1); /* Subtle dark overlay for contrast against gradient */
        backdrop-filter: blur(5px);
    }
    .btn-primary {
        background-color: white;
        color: var(--lazada-orange);
        border-color: white;
        font-weight: bold;
    }
    .btn-primary:hover {
        background-color: #f8f9fa;
        color: #e05d1a;
    }
    .btn-outline-light {
        border-width: 2px;
        font-weight: bold;
    }
</style>
