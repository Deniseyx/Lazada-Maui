@page "/"
@using Lazada_Isagunde.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Welcome to Lazada</PageTitle>

<div class="landing-container d-flex align-items-center justify-content-center">
    <div class="modern-card landing-content text-center">
        <div class="mb-5">
            <h1 class="brand-title">Lazada</h1>
            <p class="brand-subtitle">Your One-Stop Shopping Destination</p>
        </div>
        
        <div class="d-grid gap-3 px-md-4">
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/login")'>
                Login
            </button>
            <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/register")'>
                Register
            </button>
        </div>
    </div>
</div>

<style>
    .landing-container {
        min-height: calc(100vh - 150px);
        background-color: var(--lazada-bg);
    }
    .landing-content {
        max-width: 480px;
        width: 100%;
        padding: 60px 40px !important;
    }
    .brand-title {
        font-size: 3.5rem;
        font-weight: 900;
        color: var(--lazada-orange);
        letter-spacing: -2px;
        margin-bottom: 0.5rem;
        outline: none; /* Remove focus outline from FocusOnNavigate */
    }
    .brand-subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        font-weight: 400;
    }
    .btn-primary {
        background-color: var(--lazada-orange);
        border: none;
        border-radius: 8px;
        padding: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: transform 0.2s, background-color 0.2s;
        color: white;
    }
    .btn-primary:hover {
        background-color: var(--lazada-orange-deep);
        transform: translateY(-2px);
        color: white;
    }
    .btn-outline-secondary {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--text-main);
        background: transparent;
        transition: all 0.2s;
    }
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        color: var(--lazada-orange);
    }
</style>

@code {
    protected override void OnInitialized()
    {
        if (AuthService.IsLoggedIn)
        {
            if (AuthService.IsAdmin)
            {
                Navigation.NavigateTo("/admin");
            }
            else
            {
                Navigation.NavigateTo("/dashboard");
            }
        }
    }
}
