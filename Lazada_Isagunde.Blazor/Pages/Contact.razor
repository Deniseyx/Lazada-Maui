@page "/contact"
@inject NavigationManager Navigation

<PageTitle>Contact Developer - Lazada</PageTitle>

<div class="contact-container">
    <div class="contact-header"></div>
    
    <div class="contact-card p-4">
        <div class="text-center mb-4">
            <div class="profile-image-container mb-3">
                <img src="images/den.png" class="profile-image" alt="Princess Marie Denise Isagunde" onerror="this.src='images/placeholder.png'" />
            </div>
            <h2 class="developer-name">Princess Marie Denise Isagunde</h2>
            <p class="developer-title text-muted">Software Developer</p>
        </div>

        <div class="info-section mb-4">
            <h4 class="section-title text-center mb-3">Contact Information</h4>
            <div class="d-flex flex-column align-items-center">
                <div class="contact-item mb-2">
                    <span class="icon">📞</span>
                    <span class="text">09915700829</span>
                </div>
                <div class="contact-item">
                    <span class="icon">✉️</span>
                    <span class="text">deniseisagunde45@gmail.com</span>
                </div>
            </div>
        </div>

        <div class="profile-section mb-4">
            <h4 class="section-title mb-2">Professional Profile</h4>
            <p class="profile-text">
                Passionate developer dedicated to creating intuitive and efficient mobile applications. 
                Specialized in .NET MAUI and cross-platform development.
            </p>
        </div>

        <div class="text-center mt-5">
            <button class="btn btn-primary px-5" @onclick='() => Navigation.NavigateTo("/profile")'>Back to Profile</button>
        </div>
    </div>
</div>

<style>
    .contact-container {
        padding: 40px 0;
        position: relative;
    }
    .contact-header {
        background-color: var(--lazada-orange);
        height: 150px;
        border-radius: 8px 8px 0 0;
        position: absolute;
        top: 40px;
        left: 0;
        right: 0;
        z-index: 1;
    }
    .contact-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
        z-index: 2;
        margin-top: 100px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }
    .profile-image-container {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        margin: -75px auto 0;
        border: 5px solid white;
        background: #eee;
    }
    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .developer-name {
        font-size: 24px;
        font-weight: bold;
        color: #000;
    }
    .section-title {
        color: var(--lazada-orange);
        font-weight: bold;
        font-size: 18px;
    }
    .contact-item {
        font-size: 16px;
        color: #333;
    }
    .contact-item .icon {
        margin-right: 10px;
        font-size: 20px;
    }
    .profile-text {
        font-size: 14px;
        line-height: 1.6;
        color: #444;
    }
    .btn-primary {
        background-color: var(--lazada-orange);
        border-color: var(--lazada-orange);
        border-radius: 25px;
        height: 50px;
        font-weight: bold;
    }
</style>
