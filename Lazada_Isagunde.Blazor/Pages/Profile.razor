@page "/profile"
@using Lazada_Isagunde.Blazor.Services
@using Lazada_Isagunde.Blazor.Models
@inject FirebaseService FirebaseService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Account - Lazada</PageTitle>

<div class="profile-container">
    <div class="d-flex align-items-center mb-5 mt-2">
        <div class="profile-avatar-new">
            <i class="bi bi-person-circle"></i>
        </div>
        <div class="ms-4">
            <h2 class="fw-bold mb-1">@(profile?.FullName ?? AuthService?.UserDisplayName ?? "User")</h2>
            <p class="text-muted mb-0">@(AuthService?.UserEmail ?? "")</p>
        </div>
    </div>

@if (profile == null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="modern-card">
                <h4 class="section-title">Shipping Information</h4>
                
                @if (isSuccess)
                {
                    <div class="alert alert-success">Profile updated successfully!</div>
                }

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" @bind="profile.FullName" placeholder="Enter your full name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input type="tel" class="form-control" @bind="profile.PhoneNumber" placeholder="Enter phone number" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Shipping Address</label>
                    <textarea class="form-control" @bind="profile.ShippingAddress" rows="3" placeholder="Enter full address"></textarea>
                </div>

                <button class="btn btn-primary" @onclick="SaveProfile" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <span>Save Information</span>
                    }
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card p-0 overflow-hidden">
                <div class="list-group list-group-flush">
                    <a href="/orders" class="list-group-item list-group-item-action border-0 py-3 px-4">
                        <i class="bi bi-box me-3 text-muted"></i> My Orders
                    </a>
                    <a href="/seller-center" class="list-group-item list-group-item-action border-0 py-3 px-4">
                        <i class="bi bi-shop me-3 text-muted"></i> Seller Center
                    </a>
                    <a href="/contact" class="list-group-item list-group-item-action border-0 py-3 px-4">
                        <i class="bi bi-headset me-3 text-muted"></i> Contact Us
                    </a>
                    @if (AuthService?.IsAdmin ?? false)
                    {
                        <a href="/admin" class="list-group-item list-group-item-action border-0 py-3 px-4 text-primary">
                            <i class="bi bi-shield-check me-3"></i> Admin Dashboard
                        </a>
                    }
                </div>
            </div>

            <button class="btn btn-link text-danger text-decoration-none w-100 mt-2" @onclick="Logout" disabled="@isLoggingOut">
                @if (isLoggingOut)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Logging out...</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-right me-2"></i><span> Log Out</span>
                }
            </button>
        </div>
    </div>
}
</div>

@code {
    private UserProfile? profile;
    private bool isProcessing = false;
    private bool isLoggingOut = false;
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            if (AuthService == null || !AuthService.IsLoggedIn)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            profile = await FirebaseService.GetUserProfileAsync(AuthService.UserId!);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing profile: {ex.Message}");
            profile = new UserProfile();
        }
    }

    private async Task SaveProfile()
    {
        if (profile == null) return;

        isProcessing = true;
        isSuccess = false;

        await FirebaseService.SaveUserProfileAsync(profile);
        
        isSuccess = true;
        isProcessing = false;
        StateHasChanged();
    }

    private void GoToSellerCenter()
    {
        // Placeholder for Seller Center
    }

    private async Task Logout()
    {
        if (isLoggingOut) return;
        isLoggingOut = true;
        
        await AuthService.Logout();
        Navigation.NavigateTo("/");
    }
}

<style>
    .profile-avatar-new {
        font-size: 64px;
        color: var(--lazada-orange);
        line-height: 1;
    }
    .list-group-item:hover {
        background-color: #fff9f6 !important;
        color: var(--lazada-orange) !important;
    }
    .list-group-item:hover i {
        color: var(--lazada-orange) !important;
    }
    .btn-primary {
        background-color: var(--lazada-orange);
        border: none;
        border-radius: 8px;
        padding: 12px 30px;
        font-weight: 600;
    }
    .btn-primary:hover {
        background-color: var(--lazada-orange-deep);
    }
</style>
