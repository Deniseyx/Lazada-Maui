@page "/orders"
@using Lazada_Isagunde.Blazor.Services
@using Lazada_Isagunde.Blazor.Models
@inject FirebaseService FirebaseService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Orders - Lazada</PageTitle>

<div class="orders-container">
    <h2 class="section-title mb-4">My Orders</h2>

    @if (orders == null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading orders...</span>
            </div>
        </div>
    }
    else if (!orders.Any())
    {
        <div class="empty-state text-center py-5">
            <div class="empty-icon">📦</div>
            <p class="text-muted">No orders yet</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/dashboard")'>Start Shopping</button>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var order in orders)
            {
                <div class="order-card mb-4 p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="seller-name">🏪 @order.SellerName</span>
                        <span class="status-badge" style="background-color: @GetStatusColor(order.Status)">@order.Status</span>
                    </div>

                    <div class="order-items">
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "images/placeholder.png" : item.ImageUrl)" class="item-thumb" />
                                <div class="ms-3">
                                    <div class="item-title">@item.Title</div>
                                    <div class="item-qty">x@(item.Quantity)</div>
                                </div>
                                <div class="ms-auto fw-bold">@item.TotalPriceFormatted</div>
                            </div>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</small>
                        <div class="d-flex align-items-center">
                            @if (order.ShowReviewButton)
                            {
                                <button class="btn btn-sm btn-outline-primary me-3" @onclick='() => Navigation.NavigateTo($"/submit-review/{order.Id}")'>Review</button>
                            }
                            <div>
                                <span class="text-muted me-2">Total Payment:</span>
                                <span class="order-total">@order.TotalPriceFormatted</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Order>? orders;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        orders = await FirebaseService.GetUserOrdersAsync(AuthService.UserId!);
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Pending" => "#FFC107",
            "Approved" => "#28A745",
            "Shipped" => "#17A2B8",
            "Completed" => "#007BFF",
            "Cancelled" => "#DC3545",
            _ => "#6C757D"
        };
    }
}

<style>
    .orders-container {
        padding: 40px 0;
    }
    .order-card {
        background: white;
        border-radius: 8px;
        border: 1px solid #eee;
    }
    .seller-name {
        font-weight: bold;
    }
    .status-badge {
        color: white;
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
    }
    .item-thumb {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 4px;
    }
    .order-total {
        font-size: 18px;
        font-weight: bold;
        color: var(--lazada-orange);
    }
    .btn-primary {
        background-color: var(--lazada-orange);
        border-color: var(--lazada-orange);
        border-radius: 25px;
    }
</style>
