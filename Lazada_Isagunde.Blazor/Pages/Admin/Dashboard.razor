@page "/admin"
@layout Lazada_Isagunde.Blazor.Layout.AdminLayout
@using Lazada_Isagunde.Blazor.Services
@using Lazada_Isagunde.Blazor.Models
@inject FirebaseService FirebaseService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard - Lazada</PageTitle>

<div class="admin-container">
    <div class="admin-content-card shadow-sm p-4 bg-white rounded">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h3 class="fw-bold mb-0">Pending Approvals</h3>
                <p class="text-muted mb-0">Review and approve new product listings</p>
            </div>
            <div class="stats-badge bg-primary text-white rounded-pill px-3 py-1">
                @(pendingProducts?.Count ?? 0) Items
            </div>
        </div>

    @if (!AuthService.IsAdmin)
    {
        <div class="alert alert-danger">Access Denied. Admins only.</div>
    }
    else if (pendingProducts == null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (!pendingProducts.Any())
    {
        <div class="text-center py-5">
            <div class="empty-icon">📦</div>
            <p class="text-muted">No pending products to review</p>
        </div>
    }
    else
    {
        <div class="admin-list">
            @foreach (var product in pendingProducts)
            {
                <div class="admin-item-card mb-3 p-3 border rounded">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <img src="@product.DisplayImageUrl" class="item-thumb" onerror="this.src='https://placehold.co/600x400?text=No+Image'" />
                        </div>
                        <div class="col">
                            <h5 class="mb-1 fw-bold">@product.Title</h5>
                            <div class="text-muted small mb-1">Seller: <span class="text-dark fw-semibold">@product.SellerName</span></div>
                            <div class="fw-bold text-orange">@product.PriceFormatted</div>
                        </div>
                        <div class="col-auto">
                            <div class="d-flex gap-2">
                                <button class="btn btn-success px-4" @onclick='() => UpdateStatus(product.Id!, "Approved")'>Approve</button>
                                <button class="btn btn-danger px-4" @onclick='() => UpdateStatus(product.Id!, "Rejected")'>Reject</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    </div>
</div>

@code {
    private List<Product>? pendingProducts;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPending();
    }

    private async Task LoadPending()
    {
        pendingProducts = await FirebaseService.GetProductsAsync("Pending");
    }

    private async Task UpdateStatus(string productId, string status)
    {
        await FirebaseService.UpdateProductStatusAsync(productId, status);
        await LoadPending();
    }
}

<style>
    .admin-container {
        max-width: 1000px;
        margin: 0 auto;
    }
    .admin-content-card {
        min-height: 400px;
    }
    .item-thumb {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
    }
    .text-orange {
        color: var(--lazada-orange);
    }
    .empty-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }
    .btn-success {
        background-color: #27ae60;
        border: none;
        font-weight: 600;
    }
    .btn-danger {
        background-color: #e74c3c;
        border: none;
        font-weight: 600;
    }
</style>
