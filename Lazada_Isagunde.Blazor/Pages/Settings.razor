@page "/settings"
@inject NavigationManager Navigation

<PageTitle>Settings - Lazada</PageTitle>

<div class="settings-container">
    <div class="settings-card p-4">
        <h2 class="mb-4">Settings</h2>

        <div class="settings-section mb-4">
            <h5 class="fw-bold mb-3">General Settings</h5>
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Notifications</span>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Dark Mode</span>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" @onchange="ToggleDarkMode">
                </div>
            </div>
        </div>

        <div class="settings-section mb-4">
            <h5 class="fw-bold mb-3">Legal</h5>
            <div class="list-group list-group-flush">
                <a href="javascript:void(0)" class="list-group-item list-group-item-action px-0">Terms of Service</a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action px-0">Privacy Policy</a>
            </div>
        </div>

        <div class="mt-5 pt-3 border-top">
            <p class="text-muted small">App Version 1.0.0</p>
        </div>
        
        <button class="btn btn-outline-secondary w-100 mt-4" @onclick='() => Navigation.NavigateTo("/profile")'>Back to Profile</button>
    </div>
</div>

@code {
    private void ToggleDarkMode()
    {
        // Placeholder for theme toggle logic
    }
}

<style>
    .settings-container {
        padding: 40px 0;
        max-width: 600px;
        margin: 0 auto;
    }
    .settings-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #eee;
    }
    .settings-section h5 {
        color: var(--lazada-blue);
        font-size: 16px;
    }
    .form-check-input:checked {
        background-color: var(--lazada-orange);
        border-color: var(--lazada-orange);
    }
</style>
