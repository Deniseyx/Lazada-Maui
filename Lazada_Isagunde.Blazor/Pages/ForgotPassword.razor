@page "/forgot-password"
@using Lazada_Isagunde.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Reset Password</h2>
        <p class="text-muted mb-4">Enter your email to receive a password reset link.</p>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (isSuccess)
        {
            <div class="alert alert-success">
                A password reset link has been sent to your email.
            </div>
            <button class="btn btn-primary w-100" @onclick='() => Navigation.NavigateTo("/login")'>Back to Login</button>
        }
        else
        {
            <div class="form-group mb-4">
                <input type="email" class="form-control" placeholder="Email" @bind="email" />
            </div>

            <button class="btn btn-primary w-100 mb-3" @onclick="HandleReset" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Sending...</span>
                }
                else
                {
                    <span>Send Link</span>
                }
            </button>

            <div class="text-center">
                <a href="/login" class="auth-link">Back to Login</a>
            </div>
        }
    </div>
</div>

@code {
    private string email = "";
    private string errorMessage = "";
    private bool isProcessing = false;
    private bool isSuccess = false;

    private async Task HandleReset()
    {
        if (string.IsNullOrEmpty(email))
        {
            errorMessage = "Please enter your email address.";
            return;
        }

        isProcessing = true;
        errorMessage = "";

        var result = await AuthService.ResetPassword(email);
        if (result.Success)
        {
            isSuccess = true;
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isProcessing = false;
    }
}

<style>
    .auth-container {
        height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fff;
    }
    .auth-card {
        width: 100%;
        max-width: 400px;
        padding: 30px;
    }
    .auth-title {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 10px;
        color: var(--lazada-blue);
    }
    .form-control {
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        height: 50px;
        padding: 10px 15px;
    }
    .btn-primary {
        background-color: var(--lazada-orange);
        border-color: var(--lazada-orange);
        border-radius: 12px;
        height: 50px;
        font-weight: bold;
    }
    .auth-link {
        color: var(--lazada-purple);
        text-decoration: none;
        font-weight: bold;
    }
</style>
