@using Lazada_Isagunde.Blazor.Services
@inject AuthService AuthService

<header class="navbar-header">
    <div class="app-container header-content">
        <div class="header-left">
            <a class="navbar-brand" href="@(AuthService.IsLoggedIn ? "/dashboard" : "/")">Lazada Isagunde</a>
        </div>
        
        <div class="header-center">
            @if (AuthService.IsLoggedIn)
            {
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Search in Lazada..." />
                    <button class="search-button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            }
        </div>

        <div class="header-right">
            @if (AuthService.IsLoggedIn)
            {
                <a href="/profile" class="header-icon-item">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
                <a href="/cart" class="header-icon-item">
                    <i class="bi bi-cart"></i>
                    <span>Cart</span>
                </a>
            }
            else
            {
                <a href="/login" class="header-icon-item">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Login</span>
                </a>
            }
        </div>
    </div>
</header>
