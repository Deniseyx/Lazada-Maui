<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lazada_Isagunde.Models"
             x:Class="Lazada_Isagunde.Pages.ReviewPage"
             BackgroundColor="{StaticResource Gray100}"
             Title="Write a Review">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">
                <Label Text="How was your purchase?" FontSize="22" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                
                <Frame Padding="15" HasShadow="False" BackgroundColor="White" BorderColor="{StaticResource Gray200}" CornerRadius="12">
                    <VerticalStackLayout Spacing="15">
                        <Label x:Name="ProductTitleLabel" FontAttributes="Bold" HorizontalTextAlignment="Center" FontSize="16" TextColor="Black" />
                        
                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                        <Label Text="Rate this product" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black" />
                        
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Button x:Name="Star1" Text="★" FontSize="24" WidthRequest="50" HeightRequest="50" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" Clicked="OnStarClicked" CommandParameter="1" />
                            <Button x:Name="Star2" Text="★" FontSize="24" WidthRequest="50" HeightRequest="50" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" Clicked="OnStarClicked" CommandParameter="2" />
                            <Button x:Name="Star3" Text="★" FontSize="24" WidthRequest="50" HeightRequest="50" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" Clicked="OnStarClicked" CommandParameter="3" />
                            <Button x:Name="Star4" Text="★" FontSize="24" WidthRequest="50" HeightRequest="50" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" Clicked="OnStarClicked" CommandParameter="4" />
                            <Button x:Name="Star5" Text="★" FontSize="24" WidthRequest="50" HeightRequest="50" BackgroundColor="Transparent" TextColor="{StaticResource Gray200}" Clicked="OnStarClicked" CommandParameter="5" />
                        </HorizontalStackLayout>

                        <Label x:Name="RatingTextLabel" Text="Tap a star to rate" HorizontalOptions="Center" FontSize="14" TextColor="{StaticResource Gray500}" />

                        <Editor x:Name="ReviewEditor" 
                                Placeholder="Share your experience with this product..." 
                                HeightRequest="150" 
                                BackgroundColor="{StaticResource Gray100}" 
                                TextColor="Black"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Frame Grid.Row="1" Padding="15" BackgroundColor="White" HasShadow="False" CornerRadius="0">
            <Button x:Name="SubmitButton"
                    Text="Submit Review" 
                    BackgroundColor="{StaticResource LazadaOrange}" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    HeightRequest="50" 
                    CornerRadius="25" 
                    IsEnabled="False"
                    Clicked="OnSubmitClicked" />
        </Frame>
    </Grid>
</ContentPage>
