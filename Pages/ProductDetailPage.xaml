<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lazada_Isagunde.Models"
             x:Class="Lazada_Isagunde.Pages.ProductDetailPage"
             BackgroundColor="White"
             Title="Product Details">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <!-- Product Image -->
                <Image x:Name="ProductImage" 
                       HeightRequest="360" 
                       Aspect="AspectFill" 
                       BackgroundColor="{StaticResource Gray100}" />

                <VerticalStackLayout Padding="20" Spacing="10">
                    <!-- Price and Rating -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="PriceLabel" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource LazadaOrange}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label x:Name="RatingLabel" FontSize="16" TextColor="{StaticResource Black}" />
                            <Label Text="★" TextColor="Gold" FontSize="16" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Title -->
                    <Label x:Name="TitleLabel" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="Black" />

                    <!-- Seller Info -->
                    <Frame BackgroundColor="{StaticResource Gray100}" Padding="15" HasShadow="False" CornerRadius="8" Margin="0,10">
                        <HorizontalStackLayout Spacing="10">
                            <Frame WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" BackgroundColor="{StaticResource LazadaBlue}">
                                <Label Text="🏪" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="SellerNameLabel" FontAttributes="Bold" TextColor="Black" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,10" />

                    <!-- Description -->
                    <Label Text="Description" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                    <Label x:Name="DescriptionLabel" FontSize="16" TextColor="{StaticResource Gray600}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,10" />
                    
                    <Label Text="Stock" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                    <Label x:Name="StockLabel" FontSize="16" TextColor="{StaticResource Gray600}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,10" />

                    <!-- Reviews Section -->
                    <Label Text="Customer Reviews" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                    
                    <VerticalStackLayout x:Name="NoReviewsState" Padding="10" IsVisible="False">
                        <Label Text="No reviews yet" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <CollectionView x:Name="ReviewsCollection" Margin="0,10">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Review">
                                <VerticalStackLayout Spacing="5" Margin="0,0,0,15">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding BuyerName}" FontAttributes="Bold" TextColor="Black" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Rating}" TextColor="{StaticResource LazadaOrange}" FontSize="12" />
                                            <Label Text="★" TextColor="Gold" FontSize="12" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Label Text="{Binding Comment}" TextColor="{StaticResource Gray600}" FontSize="14" />
                                    <Label Text="{Binding Timestamp, StringFormat='{0:MMM dd, yyyy}'}" FontSize="10" TextColor="{StaticResource Gray400}" />
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,5,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="1" BackgroundColor="White" Padding="15" ColumnDefinitions="*, *" ColumnSpacing="15">
            <Button x:Name="AddToCartButton"
                    Text="Add to Cart"
                    BackgroundColor="{StaticResource LazadaBlue}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="25"
                    Clicked="OnAddToCartClicked" />
            
            <Button x:Name="BuyNowButton"
                    Grid.Column="1"
                    Text="Buy Now"
                    BackgroundColor="{StaticResource LazadaOrange}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="25"
                    Clicked="OnBuyNowClicked" />

            <!-- Owner Message Overlay -->
            <Label x:Name="OwnerMessageLabel"
                   Grid.Column="0" Grid.ColumnSpan="2"
                   Text="You own this product"
                   TextColor="White"
                   BackgroundColor="{StaticResource Gray500}"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontAttributes="Bold"
                   FontSize="16"
                   IsVisible="False" />
        </Grid>
    </Grid>
</ContentPage>
