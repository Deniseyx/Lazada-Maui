<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lazada_Isagunde.Pages.ForgotPasswordPage"
             BackgroundColor="White"
             Title="Forgot Password">

    <Grid WidthRequest="360" HeightRequest="640" HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
            <Label Text="Reset Password" 
                   TextColor="{StaticResource LazadaBlue}" 
                   FontSize="28" 
                   FontAttributes="Bold" />
            
            <Label Text="Enter your email to receive a password reset link." 
                   TextColor="{StaticResource Gray500}" />
            
            <Entry x:Name="EmailEntry"
                   Placeholder="Email" 
                   Keyboard="Email" 
                   BackgroundColor="{StaticResource Gray100}" />
            
            <Button Text="Send Link" 
                    BackgroundColor="{StaticResource LazadaOrange}" 
                    TextColor="White" 
                    HeightRequest="50"
                    CornerRadius="12"
                    Clicked="OnSendLinkClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
