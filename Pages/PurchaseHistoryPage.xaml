<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lazada_Isagunde.Models"
             x:Class="Lazada_Isagunde.Pages.PurchaseHistoryPage"
             BackgroundColor="{StaticResource Gray100}"
             Title="My Orders">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="15" Spacing="10">
                <CollectionView x:Name="OrdersCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Frame Margin="0,0,0,10" Padding="15" HasShadow="False" BackgroundColor="White" BorderColor="{StaticResource Gray200}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding SellerName}" FontAttributes="Bold" TextColor="Black" />
                                        <Frame Grid.Column="1" BackgroundColor="{Binding StatusColor}" Padding="8,2" CornerRadius="4" HasShadow="False" BorderColor="Transparent">
                                            <Label Text="{Binding Status}" FontSize="12" TextColor="White" FontAttributes="Bold" />
                                        </Frame>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                                    <CollectionView ItemsSource="{Binding Items}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:CartItem">
                                                <Grid ColumnDefinitions="50, *, Auto" Margin="0,5">
                                                    <Image Source="{Binding ImageUrl}" WidthRequest="40" HeightRequest="40" Aspect="AspectFill" />
                                                    <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                                                        <Label Text="{Binding Title}" MaxLines="1" FontSize="14" TextColor="Black" />
                                                        <Label Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding TotalPriceFormatted}" VerticalOptions="Center" TextColor="Black" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding DateFormatted}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <Label Text="Total Payment:" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                                            <Label Text="{Binding TotalPriceFormatted}" FontAttributes="Bold" TextColor="{StaticResource LazadaOrange}" FontSize="16" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Button Text="Review" 
                                            BackgroundColor="{StaticResource LazadaOrange}" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            HeightRequest="35"
                                            CornerRadius="17"
                                            IsVisible="{Binding ShowReviewButton}"
                                            Clicked="OnReviewClicked"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="EmptyHistoryState" 
                             HorizontalOptions="Fill" 
                             VerticalOptions="Center" 
                             Padding="20" 
                             Spacing="20" 
                             IsVisible="False">
            <Label Text="📦" FontSize="60" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label Text="No orders yet" 
                   FontSize="18" 
                   TextColor="{StaticResource Gray500}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Button Text="Start Shopping" 
                    BackgroundColor="{StaticResource LazadaOrange}" 
                    TextColor="White" 
                    WidthRequest="200"
                    HeightRequest="50"
                    CornerRadius="25"
                    HorizontalOptions="Center"
                    Clicked="OnStartShoppingClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
