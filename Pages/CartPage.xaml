<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lazada_Isagunde.Models"
             x:Class="Lazada_Isagunde.Pages.CartPage"
             BackgroundColor="{StaticResource Gray100}"
             Title="My Cart">

    <Grid RowDefinitions="*, Auto">
        <!-- Cart Items List -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15" Spacing="10">
                <CollectionView x:Name="CartCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CartItem">
                            <Border Margin="0,0,0,12" 
                                    Padding="0" 
                                    BackgroundColor="White" 
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" />
                                </Border.Shadow>

                                <Grid RowDefinitions="Auto, 1, Auto" Padding="12">
                                    <!-- Store Header -->
                                    <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                                        <CheckBox IsChecked="True" Color="{StaticResource LazadaOrange}" WidthRequest="24" HeightRequest="24" />
                                        <Label Text="🏪" VerticalOptions="Center" FontSize="14" />
                                        <Label Text="{Binding SellerName}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               TextColor="Black" 
                                               VerticalOptions="Center" />
                                        <Label Text="›" FontSize="18" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Divider -->
                                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Gray100}" Margin="-12,0" />

                                    <!-- Product Content -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto, 90, *, Auto" ColumnSpacing="12" Margin="0,12,0,0">
                                        <CheckBox Grid.Column="0" IsChecked="True" Color="{StaticResource LazadaOrange}" VerticalOptions="Center" WidthRequest="24" HeightRequest="24" />
                                        
                                        <Border Grid.Column="1" StrokeThickness="0" WidthRequest="90" HeightRequest="90">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>
                                        
                                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                                            <Label Text="{Binding Title}" 
                                                   FontAttributes="Bold" 
                                                   MaxLines="2" 
                                                   LineBreakMode="TailTruncation"
                                                   FontSize="15"
                                                   TextColor="Black" />
                                            <Label Text="Free Shipping" 
                                                   FontSize="10" 
                                                   TextColor="#00BFA5" 
                                                   BackgroundColor="#E0F2F1" 
                                                   Padding="4,2" 
                                                   HorizontalOptions="Start" />
                                            <Label Text="{Binding PriceFormatted}" 
                                                   TextColor="{StaticResource LazadaOrange}" 
                                                   FontSize="18"
                                                   FontAttributes="Bold" 
                                                   Margin="0,4,0,0" />
                                        </VerticalStackLayout>

                                        <!-- Controls -->
                                        <VerticalStackLayout Grid.Column="3" VerticalOptions="End" HorizontalOptions="End" Spacing="10">
                                            <Button Text="🗑️" 
                                                    FontSize="16" 
                                                    BackgroundColor="Transparent" 
                                                    TextColor="{StaticResource Gray400}" 
                                                    Padding="0" 
                                                    WidthRequest="30"
                                                    HeightRequest="30"
                                                    Clicked="OnRemoveItem" 
                                                    CommandParameter="{Binding .}" />
                                            
                                            <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="15" />
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                                    <Button Text="-" 
                                                            WidthRequest="28" 
                                                            HeightRequest="28" 
                                                            CornerRadius="14"
                                                            Padding="0" 
                                                            Clicked="OnDecreaseQuantity" 
                                                            CommandParameter="{Binding .}" 
                                                            BackgroundColor="White" 
                                                            TextColor="Black" 
                                                            FontSize="16" />
                                                    <Label Text="{Binding Quantity}" 
                                                           VerticalOptions="Center" 
                                                           HorizontalOptions="Center"
                                                           HorizontalTextAlignment="Center"
                                                           WidthRequest="30"
                                                           TextColor="Black" 
                                                           FontAttributes="Bold"
                                                           FontSize="14" />
                                                    <Button Text="+" 
                                                            WidthRequest="28" 
                                                            HeightRequest="28" 
                                                            CornerRadius="14"
                                                            Padding="0" 
                                                            Clicked="OnIncreaseQuantity" 
                                                            CommandParameter="{Binding .}" 
                                                            BackgroundColor="White" 
                                                            TextColor="Black" 
                                                            FontSize="16" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Centered Empty State -->
        <VerticalStackLayout x:Name="EmptyCartState" 
                             Grid.Row="0"
                             HorizontalOptions="Fill" 
                             VerticalOptions="Center" 
                             Padding="20" 
                             Spacing="20" 
                             IsVisible="False">
            <Label Text="🛒" FontSize="60" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Label Text="Your cart is empty" 
                   FontSize="18" 
                   TextColor="{StaticResource Gray500}" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />
            <Button Text="Go Shopping" 
                    BackgroundColor="{StaticResource LazadaOrange}" 
                    TextColor="White" 
                    WidthRequest="200"
                    HeightRequest="50"
                    CornerRadius="25"
                    HorizontalOptions="Center"
                    Clicked="OnGoShoppingClicked" />
        </VerticalStackLayout>

        <!-- Bottom Summary -->
        <Border Grid.Row="1" 
                BackgroundColor="White" 
                Padding="16,8" 
                StrokeThickness="1" 
                Stroke="{StaticResource Gray200}"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            
            <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                    <CheckBox IsChecked="True" Color="{StaticResource LazadaOrange}" WidthRequest="24" HeightRequest="24" />
                    <Label Text="All" FontSize="14" TextColor="Black" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start">
                    <HorizontalStackLayout HorizontalOptions="Start" Spacing="4">
                        <Label Text="Total:" FontSize="14" TextColor="Black" VerticalOptions="Center" />
                        <Label x:Name="TotalPriceLabel" 
                               Text="₱0" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource LazadaOrange}" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Saved ₱0" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start" />
                </VerticalStackLayout>
                
                <Button Grid.Column="2"
                        Text="Check Out"
                        BackgroundColor="{StaticResource LazadaOrange}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        WidthRequest="130"
                        HeightRequest="44"
                        CornerRadius="22"
                        HorizontalOptions="End"
                        Clicked="OnCheckoutClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
