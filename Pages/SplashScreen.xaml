<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lazada_Isagunde.Pages.SplashScreen"
             BackgroundColor="{StaticResource LazadaOrange}"
             NavigationPage.HasNavigationBar="False">

    <Grid WidthRequest="360" HeightRequest="640" HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
            <Label Text="LAZADA" 
                   TextColor="White" 
                   FontSize="48" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />
            
            <ActivityIndicator IsRunning="True" Color="White" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
