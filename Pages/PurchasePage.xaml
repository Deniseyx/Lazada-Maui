<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lazada_Isagunde.Pages.PurchasePage"
             BackgroundColor="{StaticResource Gray100}"
             Title="Checkout">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15" Spacing="15">
                
                <!-- Shipping Address Section -->
                <Frame BackgroundColor="White" Padding="15" HasShadow="False" CornerRadius="8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Shipping Address" FontAttributes="Bold" TextColor="Black" FontSize="16" />
                        
                        <CheckBox x:Name="UseSavedAddressCb" IsChecked="True" Color="{StaticResource LazadaOrange}" />
                        <Label Text="Use saved shipping details" TextColor="{StaticResource Gray600}" Margin="35,-35,0,0" />

                        <VerticalStackLayout x:Name="CustomAddressSection" Spacing="10" Margin="0,10,0,0" IsVisible="False">
                            <Entry x:Name="CustomNameEntry" Placeholder="Receiver Name" BackgroundColor="{StaticResource Gray100}" TextColor="Black" />
                            <Entry x:Name="CustomPhoneEntry" Placeholder="Phone Number" Keyboard="Telephone" BackgroundColor="{StaticResource Gray100}" TextColor="Black" />
                            <Editor x:Name="CustomAddressEditor" Placeholder="Full Address" BackgroundColor="{StaticResource Gray100}" HeightRequest="80" TextColor="Black" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="SavedAddressDisplay" Spacing="2">
                            <Label x:Name="SavedNameLabel" FontAttributes="Bold" TextColor="Black" />
                            <Label x:Name="SavedPhoneLabel" TextColor="{StaticResource Gray600}" />
                            <Label x:Name="SavedAddressLabel" TextColor="{StaticResource Gray600}" MaxLines="2" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Order Items Summary -->
                <Frame BackgroundColor="White" Padding="15" HasShadow="False" CornerRadius="8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Order Summary" FontAttributes="Bold" TextColor="Black" FontSize="16" />
                        <CollectionView x:Name="ItemsSummaryCollection" HeightRequest="150">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="50, *, Auto" Margin="0,5">
                                        <Image Source="{Binding ImageUrl}" WidthRequest="40" HeightRequest="40" Aspect="AspectFill" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                            <Label Text="{Binding Title}" MaxLines="1" FontSize="12" TextColor="Black" />
                                            <Label Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TotalPriceFormatted}" VerticalOptions="Center" TextColor="Black" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Payment Method Section -->
                <Frame BackgroundColor="White" Padding="15" HasShadow="False" CornerRadius="8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Payment Method" FontAttributes="Bold" TextColor="Black" FontSize="16" />
                        <RadioButton x:Name="CodRb" Content="Cash on Delivery (COD)" IsChecked="True" TextColor="Black" />
                        <RadioButton x:Name="GcashRb" Content="GCash" TextColor="Black" />
                        <RadioButton x:Name="CardRb" Content="Credit/Debit Card" TextColor="Black" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Price Breakdown Section -->
                <Frame BackgroundColor="White" Padding="15" HasShadow="False" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Merchandise Subtotal" TextColor="{StaticResource Gray600}" />
                            <Label x:Name="SubtotalLabel" Grid.Column="1" TextColor="Black" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Shipping Fee" TextColor="{StaticResource Gray600}" />
                            <Label x:Name="ShippingFeeLabel" Grid.Column="1" TextColor="Black" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,5" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Total Payment" FontAttributes="Bold" TextColor="Black" FontSize="18" />
                            <Label x:Name="TotalPaymentLabel" Grid.Column="1" FontAttributes="Bold" TextColor="{StaticResource LazadaOrange}" FontSize="18" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Place Order Button -->
        <Frame Grid.Row="1" BackgroundColor="White" Padding="15" HasShadow="False" CornerRadius="0">
            <Button Text="Place Order" 
                    BackgroundColor="{StaticResource LazadaOrange}" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    HeightRequest="50" 
                    CornerRadius="25"
                    Clicked="OnPlaceOrderClicked" />
        </Frame>
    </Grid>
</ContentPage>
