<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lazada_Isagunde.Models"
             x:Class="Lazada_Isagunde.Pages.DashboardPage"
             BackgroundColor="{StaticResource Gray100}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto, Auto" 
              Padding="10,0,15,0" 
              ColumnSpacing="10" 
              BackgroundColor="{StaticResource LazadaOrange}"
              HorizontalOptions="Fill">
            
            <Label Text="Lazada" 
                   VerticalOptions="Center" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="White" />

            <Frame Grid.Column="1"
                   HeightRequest="36"
                   WidthRequest="36"
                   CornerRadius="18"
                   Padding="0"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="Transparent"
                   VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCartClicked" />
                </Frame.GestureRecognizers>
                <Label Text="🛒" 
                       TextColor="{StaticResource LazadaOrange}" 
                       FontSize="18" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Frame>
            
            <Frame Grid.Column="2"
                   HeightRequest="36"
                   WidthRequest="36"
                   CornerRadius="18"
                   Padding="0"
                   HasShadow="False"
                   BackgroundColor="White"
                   BorderColor="Transparent"
                   VerticalOptions="Center">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileClicked" />
                </Frame.GestureRecognizers>
                <Label Text="👤" 
                       TextColor="{StaticResource LazadaOrange}" 
                       FontSize="20" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Frame>
        </Grid>
    </Shell.TitleView>

    <Grid WidthRequest="360" HorizontalOptions="Center">
        <ScrollView>
            <VerticalStackLayout Padding="15,20,15,15" Spacing="15">
                <!-- Search Bar -->
                <Frame BackgroundColor="White" Padding="0" HasShadow="False" CornerRadius="10" HeightRequest="45">
                    <Entry Placeholder="Search products..." Margin="10,0" TextColor="Black" />
                </Frame>



                <!-- Product List Header -->
                <Label Text="Just For You" FontSize="20" FontAttributes="Bold" TextColor="Black" />

                <!-- Dynamic Product Grid -->
                <CollectionView x:Name="ProductsCollection"
                                ItemsLayout="VerticalGrid, 2">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Frame WidthRequest="160" 
                                   HeightRequest="220" 
                                   Padding="0" 
                                   Margin="5" 
                                   CornerRadius="8" 
                                   HasShadow="False" 
                                   BackgroundColor="White">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Image Source="{Binding DisplayImageUrl}"
                                           HeightRequest="140"
                                           Aspect="AspectFill"
                                           BackgroundColor="{StaticResource Gray200}" />
                                    <Label Text="{Binding Title}" 
                                           Margin="10,5,10,0" 
                                           FontAttributes="Bold" 
                                           MaxLines="2"
                                           TextColor="Black" />
                                    <Label Text="{Binding PriceFormatted}" 
                                           Margin="10,0" 
                                           TextColor="{StaticResource LazadaOrange}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
