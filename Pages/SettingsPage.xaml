<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lazada_Isagunde.Pages.SettingsPage"
             BackgroundColor="White"
             Title="Settings">

    <Grid WidthRequest="360" HeightRequest="640" HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="General Settings" FontSize="18" FontAttributes="Bold" />
            
            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="True" />
                <Label Text="Notifications" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="False" />
                <Label Text="Dark Mode" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Legal" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="Terms of Service" />
            <Label Text="Privacy Policy" />
            
            <Label Text="App Version 1.0.0" TextColor="{StaticResource Gray500}" FontSize="12" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
