<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lazada_Isagunde.Models"
             x:Class="Lazada_Isagunde.Pages.AdminDashboardPage"
             Title="Admin Dashboard"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource LazadaBlue}" Padding="15, 40, 15, 15" ColumnDefinitions="*, Auto">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="ADMIN CENTER" 
                       TextColor="White" 
                       FontSize="20" 
                       FontAttributes="Bold" />
                <Label Text="Pending Approvals" 
                       TextColor="White" 
                       FontSize="12" 
                       Opacity="0.8" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Logout"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    BorderColor="White"
                    BorderWidth="1"
                    HeightRequest="35"
                    FontSize="12"
                    Clicked="OnLogoutClicked"/>
        </Grid>

        <!-- Content -->
        <RefreshView Grid.Row="1" x:Name="RefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="PendingList">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="📦" FontSize="50" HorizontalOptions="Center" Opacity="0.5" />
                        <Label Text="No pending products" 
                               TextColor="{StaticResource Gray500}"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Frame Margin="10, 5" Padding="10" HasShadow="False" BorderColor="{StaticResource Gray200}">
                            <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="15">
                                <Image Grid.Column="0" 
                                       Source="{Binding DisplayImageUrl}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="80" 
                                       WidthRequest="80" />
                                
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" MaxLines="1" />
                                    <Label Text="{Binding SellerName}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding PriceFormatted}" TextColor="{StaticResource LazadaOrange}" FontAttributes="Bold" Margin="0, 5, 0, 0" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                    <Button Text="Approve" 
                                            BackgroundColor="Green" 
                                            TextColor="White" 
                                            FontSize="11" 
                                            Padding="10, 0"
                                            HeightRequest="35"
                                            Clicked="OnApproveClicked"
                                            CommandParameter="{Binding .}"/>
                                    <Button Text="Reject" 
                                            BackgroundColor="Red" 
                                            TextColor="White" 
                                            FontSize="11" 
                                            Padding="10, 0"
                                            HeightRequest="35"
                                            Clicked="OnRejectClicked"
                                            CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
